<!-- ═══════════ PAGE-SPECIFIC SCRIPTS ═══════════ -->
<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Hero entrance animation ── */
  const hero = document.getElementById('viviendas-hero');
  if (hero && !prefersReducedMotion) {
    const breadcrumb = hero.querySelector('nav');
    const label = hero.querySelector('.label-md');
    const heading = hero.querySelector('h1');
    const desc = hero.querySelector('p');
    const ctas = hero.querySelectorAll('[data-hero-ctas] > a');
    const tl = gsap.timeline({ delay: 0.2 });
    if (breadcrumb) tl.fromTo(breadcrumb, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out' });
    if (label) tl.fromTo(label, { opacity: 0, y: 25 }, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.25');
    if (heading) tl.fromTo(heading, { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' }, '-=0.35');
    if (desc) tl.fromTo(desc, { opacity: 0, y: 25 }, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.45');
    if (ctas.length) tl.fromTo(ctas, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.55, stagger: 0.12, ease: 'power3.out' }, '-=0.35');
  } else if (hero) {
    hero.querySelectorAll('.hero-anim-init').forEach((el) => (el as HTMLElement).style.opacity = '1');
  }
</script>
