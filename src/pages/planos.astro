---
import Layout from '../layouts/Layout.astro';
---

<Layout
  currentPage="planos"
  title="Planos y Disponibilidad — Molí Baix"
  description="Consulta los planos y la disponibilidad de las viviendas de Molí Baix en Massamagrell. Lofts, áticos, 1, 2 y 3 dormitorios desde 145.000€."
>

  <!-- ═══════════ PAGE HERO ═══════════ -->
  <section class="relative min-h-screen flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img width="1920" height="1080" fetchpriority="high" decoding="async" class="w-full h-full object-cover object-center scale-105"
        src="/images/plano-exterior-frontal.webp"
        alt="Fachada frontal del edificio Molí Baix" />
      <div class="absolute inset-0 bg-gradient-to-r from-on-background/70 via-on-background/40 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-on-background/30 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full py-32 lg:py-40" id="planos-hero">
      <nav aria-label="Breadcrumb" class="hero-anim-init flex items-center gap-2 text-sm text-white/50 mb-8">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span class="material-symbols-outlined text-base">chevron_right</span>
        <span class="text-white" aria-current="page">Planos y Disponibilidad</span>
      </nav>
      <span class="hero-anim-init label-md tracking-[0.25em] text-primary-fixed-dim mb-4 block font-bold">Planos y Disponibilidad</span>
      <h1 class="hero-anim-init text-4xl sm:text-5xl lg:text-7xl font-extrabold font-headline text-white mb-6">
        Elige tu<br/>vivienda
      </h1>
      <p class="hero-anim-init text-xl lg:text-2xl text-white/70 max-w-xl font-light mb-10">
        Consulta la disponibilidad en tiempo real, compara superficies y encuentra la vivienda perfecta para ti.
      </p>
      <div class="flex flex-wrap items-center gap-4" data-hero-ctas>
        <a href="#disponibilidad" class="hero-anim-init inline-flex items-center gap-2.5 btn-primary-gradient text-on-primary px-10 py-4 rounded-full font-semibold text-lg transition-all active:scale-95 hover:shadow-xl">
          <span class="material-symbols-outlined text-xl">table_view</span>
          Ver Disponibilidad
        </a>
        <button id="tour-open" type="button" aria-haspopup="dialog" aria-controls="tour-modal" class="hero-anim-init inline-flex items-center gap-2.5 bg-white/10 backdrop-blur-sm border-2 border-white/30 text-white px-8 py-4 rounded-full font-semibold text-lg transition-all hover:bg-white/20 hover:border-white/50 active:scale-95 group">
          <span class="material-symbols-outlined text-2xl group-hover:rotate-12 transition-transform duration-300">360</span>
          Vista 360°
        </button>
      </div>
    </div>
  </section>

  <!-- Modal Vista 360° -->
  <div id="tour-modal" role="dialog" aria-modal="true" aria-labelledby="tour-modal-title" aria-hidden="true" class="fixed inset-0 z-[100] hidden items-center justify-center bg-on-background/80 backdrop-blur-sm p-4" style="overscroll-behavior: contain;">
    <div tabindex="-1" class="bg-white rounded-2xl w-full max-w-6xl h-[90vh] flex flex-col editorial-shadow-lg overflow-hidden">
      <div class="flex items-center justify-between px-6 py-4 border-b border-surface-container-high/40">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-primary text-2xl">360</span>
          <h3 id="tour-modal-title" class="font-bold font-headline text-on-background">Vista 360° — Interior de vivienda</h3>
        </div>
        <button id="tour-close" type="button" aria-label="Cerrar vista 360°" class="w-9 h-9 rounded-full flex items-center justify-center hover:bg-surface-container transition-colors">
          <span class="material-symbols-outlined text-on-background">close</span>
        </button>
      </div>
      <div class="flex-1 overflow-hidden">
        <iframe id="tour-iframe" title="Tour virtual 360° del interior de la vivienda" class="w-full h-full border-0" src="" allow="fullscreen; gyroscope; accelerometer"></iframe>
      </div>
    </div>
  </div>


  <!-- ═══════════ RESUMEN RÁPIDO ═══════════ -->
  <section class="py-12 lg:py-16 bg-surface-container-lowest border-b border-surface-container-high/40">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 lg:gap-6 anim-reveal">
        <div class="text-center p-6 lg:p-8 rounded-2xl bg-surface-container border border-surface-container-high/40">
          <p class="text-3xl lg:text-4xl font-extrabold font-headline text-primary tabular-nums">78</p>
          <p class="label-md text-secondary mt-2">Viviendas</p>
        </div>
        <div class="text-center p-6 lg:p-8 rounded-2xl bg-surface-container border border-surface-container-high/40">
          <p class="text-3xl lg:text-4xl font-extrabold font-headline text-primary tabular-nums">6</p>
          <p class="label-md text-secondary mt-2">Tipologías</p>
        </div>
        <div class="text-center p-6 lg:p-8 rounded-2xl bg-surface-container border border-surface-container-high/40">
          <p class="text-3xl lg:text-4xl font-extrabold font-headline text-primary tabular-nums">61–252</p>
          <p class="label-md text-secondary mt-2">m² construidos</p>
        </div>
        <div class="text-center p-6 lg:p-8 rounded-2xl bg-surface-container border border-surface-container-high/40">
          <p class="text-3xl lg:text-4xl font-extrabold font-headline text-primary tabular-nums">145.000€</p>
          <p class="label-md text-secondary mt-2">Desde</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════ TABLA DE DISPONIBILIDAD ═══════════ -->
  <section class="py-12 lg:py-16 bg-surface-container-lowest" id="disponibilidad">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-12 lg:mb-14 anim-reveal">
        <span class="label-md tracking-[0.25em] text-primary mb-3 block font-bold">Disponibilidad</span>
        <h2 class="text-3xl lg:text-5xl font-extrabold font-headline text-on-background mb-6">
          Todas las viviendas
        </h2>
        <div class="divider-soft mx-auto mb-6"></div>
        <p class="text-on-surface-variant text-lg">
          Filtra por dormitorios, planta o estado para encontrar tu vivienda ideal.
        </p>
      </div>

      <!-- Filtros -->
      <div class="flex flex-wrap items-center gap-3 mb-8 anim-reveal" id="filters">
        <span class="text-sm font-semibold text-on-background mr-2" id="filter-label">Filtrar:</span>

        <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por número de dormitorios">
          <button type="button" class="filter-btn" data-filter="dorm" data-value="all" aria-pressed="true">Todos</button>
          <button type="button" class="filter-btn" data-filter="dorm" data-value="1" aria-pressed="false">1 Dorm.</button>
          <button type="button" class="filter-btn" data-filter="dorm" data-value="2" aria-pressed="false">2 Dorm.</button>
          <button type="button" class="filter-btn" data-filter="dorm" data-value="3" aria-pressed="false">3 Dorm.</button>
        </div>

        <div class="w-px h-6 bg-surface-container-high mx-2 hidden sm:block" aria-hidden="true"></div>

        <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por planta">
          <button type="button" class="filter-btn" data-filter="planta" data-value="all" aria-pressed="true">Todas</button>
          <button type="button" class="filter-btn" data-filter="planta" data-value="0" aria-pressed="false">PB</button>
          <button type="button" class="filter-btn" data-filter="planta" data-value="1" aria-pressed="false">P1</button>
          <button type="button" class="filter-btn" data-filter="planta" data-value="2" aria-pressed="false">P2</button>
          <button type="button" class="filter-btn" data-filter="planta" data-value="3" aria-pressed="false">P3</button>
          <button type="button" class="filter-btn" data-filter="planta" data-value="4" aria-pressed="false">Ático</button>
        </div>

        <div class="w-px h-6 bg-surface-container-high mx-2 hidden sm:block" aria-hidden="true"></div>

        <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por estado">
          <button type="button" class="filter-btn" data-filter="estado" data-value="all" aria-pressed="true">Todos</button>
          <button type="button" class="filter-btn" data-filter="estado" data-value="disponible" aria-pressed="false">Disponible</button>
          <button type="button" class="filter-btn" data-filter="estado" data-value="no_disponible" aria-pressed="false">No disponible</button>
          <button type="button" class="filter-btn" data-filter="estado" data-value="vendido" aria-pressed="false">Vendido</button>
        </div>
      </div>

      <!-- Contador de resultados -->
      <p class="text-sm text-secondary mb-4 tabular-nums" id="result-count" role="status" aria-live="polite">Mostrando 78 viviendas</p>


      <!-- Tabla (desktop) -->
      <div class="hidden md:block overflow-x-auto rounded-2xl border border-surface-container-high/40 editorial-shadow anim-reveal">
        <table class="w-full text-sm" id="units-table">
          <caption class="sr-only">Disponibilidad de viviendas por planta, tipología, superficie y precio</caption>
          <thead>
            <tr class="bg-surface-container text-left">
              <th scope="col" class="px-5 py-4 font-bold text-on-background text-xs uppercase tracking-wider">Vivienda</th>
              <th scope="col" class="px-5 py-4 font-bold text-on-background text-xs uppercase tracking-wider">Planta</th>
              <th scope="col" class="px-5 py-4 font-bold text-on-background text-xs uppercase tracking-wider">Dorm.</th>
              <th scope="col" class="px-5 py-4 font-bold text-on-background text-xs uppercase tracking-wider">Superficie</th>
              <th scope="col" class="px-5 py-4 font-bold text-on-background text-xs uppercase tracking-wider text-center">Parking</th>
              <th scope="col" class="px-5 py-4 font-bold text-on-background text-xs uppercase tracking-wider text-center">Trastero</th>
              <th scope="col" class="px-5 py-4 font-bold text-on-background text-xs uppercase tracking-wider text-center">Planos</th>
              <th scope="col" class="px-5 py-4 font-bold text-on-background text-xs uppercase tracking-wider text-right">Precio</th>
              <th scope="col" class="px-5 py-4 font-bold text-on-background text-xs uppercase tracking-wider text-center">Estado</th>
            </tr>
          </thead>
          <tbody id="units-body">
          </tbody>
        </table>
      </div>

      <!-- Cards (mobile) -->
      <div class="md:hidden space-y-3" id="units-cards">
      </div>

      <!-- Modal visor de planos -->
      <div id="plan-modal" role="dialog" aria-modal="true" aria-labelledby="plan-modal-title" aria-hidden="true" class="fixed inset-0 z-[100] hidden items-center justify-center bg-on-background/60 backdrop-blur-sm p-4" style="overscroll-behavior: contain;">
        <div tabindex="-1" class="bg-white rounded-2xl w-full max-w-4xl max-h-[90vh] flex flex-col editorial-shadow-lg overflow-hidden">
          <div class="flex items-center justify-between px-6 py-4 border-b border-surface-container-high/40">
            <h3 class="font-bold font-headline text-on-background" id="plan-modal-title">Plano</h3>
            <div class="flex items-center gap-3">
              <a id="plan-open-tab" href="#" target="_blank" rel="noopener" aria-label="Abrir plano en nueva pestaña" class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:text-primary-container transition-colors">
                <span class="material-symbols-outlined text-base">open_in_new</span> Abrir
              </a>
              <a id="plan-download" href="#" download aria-label="Descargar plano en PDF" class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:text-primary-container transition-colors">
                <span class="material-symbols-outlined text-base">download</span> Descargar
              </a>
              <button id="plan-close" type="button" aria-label="Cerrar visor de plano" class="w-9 h-9 rounded-full flex items-center justify-center hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined text-on-background">close</span>
              </button>
            </div>
          </div>
          <div class="flex-1 overflow-auto p-4 bg-surface-container">
            <iframe id="plan-iframe" title="Visor de plano de vivienda en PDF" class="w-full h-[70vh] rounded-xl border-0" src=""></iframe>
          </div>
        </div>
      </div>

      <p class="text-xs text-secondary italic mt-6 text-center">* Precios sin 10% de IVA. Superficies construidas con elementos comunes. Plazas de garaje y trasteros opcionales según disponibilidad.</p>
    </div>
  </section>


  <!-- ═══════════ TIPOLOGÍAS RESUMEN ═══════════ -->
  <section class="py-16 lg:py-24 bg-surface-container">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-12 lg:mb-14 anim-reveal">
        <span class="label-md tracking-[0.25em] text-primary mb-4 block font-bold">Tipologías</span>
        <h2 class="text-3xl lg:text-5xl font-extrabold font-headline text-on-background mb-4">
          Resumen por tipología
        </h2>
        <div class="divider-accent mx-auto mb-6"></div>
        <p class="text-on-surface-variant text-lg">
          Cada tipología ofrece una distribución diferente para adaptarse a tus necesidades.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 anim-reveal">
        <!-- Loft -->
        <div class="bg-white rounded-2xl p-8 editorial-shadow border border-surface-container-high/40 group">
          <div class="flex items-center justify-between mb-5">
            <div class="w-14 h-14 rounded-2xl bg-primary-fixed flex items-center justify-center transition-transform duration-300">
              <span class="material-symbols-outlined text-primary text-xl">apartment</span>
            </div>
            <span class="label-md bg-primary-fixed text-on-primary-fixed-variant px-3 py-1 rounded-full">Desde 145.000€</span>
          </div>
          <h3 class="text-lg font-extrabold font-headline text-on-background mb-2">Loft</h3>
          <p class="text-secondary text-sm mb-4">1 dormitorio + 1 baño. Planta baja con terraza privada.</p>
          <div class="flex items-center gap-4 text-xs text-secondary">
            <span>75–134 m²</span>
            <span class="w-1 h-1 rounded-full bg-secondary"></span>
            <span>Terraza: 10–23 m²</span>
          </div>
        </div>

        <!-- 1 Dormitorio -->
        <div class="bg-white rounded-2xl p-8 editorial-shadow border border-surface-container-high/40 group">
          <div class="flex items-center justify-between mb-5">
            <div class="w-14 h-14 rounded-2xl bg-primary-fixed flex items-center justify-center transition-transform duration-300">
              <span class="material-symbols-outlined text-primary text-xl">bed</span>
            </div>
            <span class="label-md bg-primary-fixed text-on-primary-fixed-variant px-3 py-1 rounded-full">Desde 165.000€</span>
          </div>
          <h3 class="text-lg font-extrabold font-headline text-on-background mb-2">1 Dormitorio</h3>
          <p class="text-secondary text-sm mb-4">1 dormitorio + 1 baño. Plantas 1ª a 3ª.</p>
          <div class="flex items-center gap-4 text-xs text-secondary">
            <span>61–116 m²</span>
            <span class="w-1 h-1 rounded-full bg-secondary"></span>
            <span>Terraza: 3–58 m²</span>
          </div>
        </div>

        <!-- 2 Dormitorios -->
        <div class="bg-white rounded-2xl p-8 editorial-shadow border border-surface-container-high/40 group">
          <div class="flex items-center justify-between mb-5">
            <div class="w-14 h-14 rounded-2xl bg-primary-fixed flex items-center justify-center transition-transform duration-300">
              <span class="material-symbols-outlined text-primary text-xl">door_sliding</span>
            </div>
            <span class="label-md bg-primary-fixed text-on-primary-fixed-variant px-3 py-1 rounded-full">Desde 209.000€</span>
          </div>
          <h3 class="text-lg font-extrabold font-headline text-on-background mb-2">2 Dormitorios</h3>
          <p class="text-secondary text-sm mb-4">2 dormitorios + 2 baños. Plantas 1ª a 3ª.</p>
          <div class="flex items-center gap-4 text-xs text-secondary">
            <span>88–189 m²</span>
            <span class="w-1 h-1 rounded-full bg-secondary"></span>
            <span>Terraza: 4–105 m²</span>
          </div>
        </div>

        <!-- 3 Dormitorios -->
        <div class="bg-white rounded-2xl p-8 editorial-shadow border border-surface-container-high/40 group">
          <div class="flex items-center justify-between mb-5">
            <div class="w-14 h-14 rounded-2xl bg-primary-fixed flex items-center justify-center transition-transform duration-300">
              <span class="material-symbols-outlined text-primary text-xl">family_restroom</span>
            </div>
            <span class="label-md bg-primary-fixed text-on-primary-fixed-variant px-3 py-1 rounded-full">Desde 254.000€</span>
          </div>
          <h3 class="text-lg font-extrabold font-headline text-on-background mb-2">3 Dormitorios</h3>
          <p class="text-secondary text-sm mb-4">3 dormitorios + 2 baños. Plantas 1ª a 4ª.</p>
          <div class="flex items-center gap-4 text-xs text-secondary">
            <span>122–252 m²</span>
            <span class="w-1 h-1 rounded-full bg-secondary"></span>
            <span>Terraza: 5–136 m²</span>
          </div>
        </div>

        <!-- 3 Dorm Esquinero -->
        <div class="bg-white rounded-2xl p-8 editorial-shadow border border-surface-container-high/40 group">
          <div class="flex items-center justify-between mb-5">
            <div class="w-14 h-14 rounded-2xl bg-primary-fixed flex items-center justify-center transition-transform duration-300">
              <span class="material-symbols-outlined text-primary text-xl">open_in_full</span>
            </div>
            <span class="label-md bg-primary-fixed text-on-primary-fixed-variant px-3 py-1 rounded-full">Desde 260.000€</span>
          </div>
          <h3 class="text-lg font-extrabold font-headline text-on-background mb-2">3 Dorm. Esquinero</h3>
          <p class="text-secondary text-sm mb-4">3 dormitorios + 2 baños. Orientación Sur.</p>
          <div class="flex items-center gap-4 text-xs text-secondary">
            <span>129 m²</span>
            <span class="w-1 h-1 rounded-full bg-secondary"></span>
            <span>Terraza: 7,65 m²</span>
          </div>
        </div>

        <!-- Ático -->
        <div class="bg-white rounded-2xl p-8 editorial-shadow border border-surface-container-high/40 group">
          <div class="flex items-center justify-between mb-5">
            <div class="w-14 h-14 rounded-2xl bg-primary-fixed flex items-center justify-center transition-transform duration-300">
              <span class="material-symbols-outlined text-primary text-xl">wb_twilight</span>
            </div>
            <span class="label-md bg-primary-fixed text-on-primary-fixed-variant px-3 py-1 rounded-full">Desde 191.000€</span>
          </div>
          <h3 class="text-lg font-extrabold font-headline text-on-background mb-2">Ático</h3>
          <p class="text-secondary text-sm mb-4">1, 2 o 3 dormitorios. Solárium privado.</p>
          <div class="flex items-center gap-4 text-xs text-secondary">
            <span>93–226 m²</span>
            <span class="w-1 h-1 rounded-full bg-secondary"></span>
            <span>Terraza: 36–107 m²</span>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════ CTA ═══════════ -->
  <section class="py-16 lg:py-24 bg-primary relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(255,255,255,0.1),transparent_60%)]"></div>
    <div class="absolute top-0 right-0 w-64 h-64 rounded-full bg-white/5 -translate-y-1/2 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 rounded-full bg-white/5 translate-y-1/3 -translate-x-1/4"></div>
    <div class="max-w-4xl mx-auto px-6 lg:px-8 relative z-10 text-center anim-reveal">
      <span class="material-symbols-outlined text-white/80 text-5xl mb-6 block">call</span>
      <h2 class="text-3xl lg:text-5xl font-extrabold font-headline text-white mb-4">
        ¿Necesitas ayuda para elegir?
      </h2>
      <p class="text-white/70 text-lg mb-6 max-w-xl mx-auto">
        Nuestro equipo comercial te guiará en la elección perfecta para ti y tu familia. Sin compromiso.
      </p>
      <a href="tel:+34620197665" class="text-white text-2xl font-extrabold font-headline mb-8 block hover:text-white/80 transition-colors tabular-nums">(+34) 620 197 665</a>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/#contacto" class="bg-white text-primary px-10 py-4 rounded-full font-semibold text-lg transition-all active:scale-95 hover:shadow-xl hover:bg-white/90">
          Contactar con Ventas
        </a>
        <a href="/viviendas" class="border-2 border-white/30 text-white px-10 py-4 rounded-full font-semibold text-lg transition-all hover:bg-white/10 active:scale-95">
          Ver Viviendas
        </a>
      </div>
    </div>
  </section>

</Layout>


<!-- ═══════════ STYLES ═══════════ -->
<style>
  .filter-btn {
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    border: 1.5px solid var(--color-surface-container-high);
    color: var(--color-secondary);
    background: transparent;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .filter-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .filter-btn.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  #units-table tbody tr {
    border-top: 1px solid var(--color-surface-container-high);
    transition: background 0.15s ease;
  }
  #units-table tbody tr:hover {
    background: var(--color-primary-fixed);
  }
  #units-table tbody tr.hidden {
    display: none;
  }

  .status-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .status-disponible {
    background: #dcfce7;
    color: #166534;
  }
  .status-reservado {
    background: #fef3c7;
    color: #92400e;
  }
  .status-vendido {
    background: var(--color-surface-container-high);
    color: var(--color-secondary);
  }
  .status-no_disponible {
    background: #fde8e8;
    color: #991b1b;
  }
</style>


<!-- ═══════════ SCRIPTS ═══════════ -->
<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Hero entrance ── */
  const hero = document.getElementById('planos-hero');
  if (hero && !prefersReducedMotion) {
    const breadcrumb = hero.querySelector('nav');
