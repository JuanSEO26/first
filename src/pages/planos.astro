  const tourIframe = document.getElementById('tour-iframe') as HTMLIFrameElement;
  const tourOpen = document.getElementById('tour-open')!;
  const tourClose = document.getElementById('tour-close')!;
  const tourUrl = 'https://vicom360.es/VIBO_Massamagrell/tour/index.html';

  tourOpen.addEventListener('click', () => {
    tourIframe.src = tourUrl;
    tourModal.classList.remove('hidden');
    tourModal.classList.add('flex');
    tourModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  });

  tourClose.addEventListener('click', closeTour);
  tourModal.addEventListener('click', (e) => {
    if (e.target === tourModal) closeTour();
  });

  function closeTour() {
    tourModal.classList.add('hidden');
    tourModal.classList.remove('flex');
    tourModal.setAttribute('aria-hidden', 'true');
    tourIframe.src = '';
    document.body.style.overflow = '';
  }
</script>
