  /* ── Filters ── */
  const activeFilters: Record<string, string> = { dorm: 'all', planta: 'all', estado: 'all' };

  /* ── Apply initial filters from URL params (?dorm=2&planta=4) ── */
  const urlParams = new URLSearchParams(window.location.search);
  (['dorm', 'planta', 'estado'] as const).forEach((key) => {
    const val = urlParams.get(key);
    if (val) {
      activeFilters[key] = val;
      document.querySelectorAll(`.filter-btn[data-filter="${key}"]`).forEach(b => b.setAttribute('aria-pressed', 'false'));
      const target = document.querySelector(`.filter-btn[data-filter="${key}"][data-value="${val}"]`);
      target?.setAttribute('aria-pressed', 'true');
    }
  });
  if (urlParams.toString()) {
    applyFilters();
    // Scroll to availability section after layout settles
    setTimeout(() => {
      document.getElementById('disponibilidad')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 300);
  }

  function syncUrl() {
    const params = new URLSearchParams();
    (Object.keys(activeFilters) as Array<keyof typeof activeFilters>).forEach((k) => {
      if (activeFilters[k] !== 'all') params.set(k, activeFilters[k]);
    });
    const qs = params.toString();
    const newUrl = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
    window.history.replaceState(null, '', newUrl + window.location.hash);
  }

  document.getElementById('filters')!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.filter-btn') as HTMLElement | null;
    if (!btn) return;

    const filterType = btn.dataset.filter!;
    const value = btn.dataset.value!;
    activeFilters[filterType] = value;

    // Update aria-pressed within this group
    document.querySelectorAll(`.filter-btn[data-filter="${filterType}"]`).forEach(b => b.setAttribute('aria-pressed', 'false'));
    btn.setAttribute('aria-pressed', 'true');

    applyFilters();
    syncUrl();
  });

  function applyFilters() {
    let visible = 0;
    // Filter both table rows and mobile cards
    const items = [...tbody.querySelectorAll('tr'), ...cardsContainer.querySelectorAll('.unit-card')];
    items.forEach(item => {
      const el = item as HTMLElement;
      const matchDorm = activeFilters.dorm === 'all' || el.dataset.dorm === activeFilters.dorm;
      const matchPlanta = activeFilters.planta === 'all' || el.dataset.planta === activeFilters.planta;
      const matchEstado = activeFilters.estado === 'all' || el.dataset.estado === activeFilters.estado;

      if (matchDorm && matchPlanta && matchEstado) {
        el.classList.remove('hidden');
        // Only count once (from table rows, not cards)
        if (el.tagName === 'TR') visible++;
      } else {
        el.classList.add('hidden');
      }
    });
    countEl.textContent = `Mostrando ${visible} vivienda${visible !== 1 ? 's' : ''}`;
  }

  /* ── Plan modal ── */
  const modal = document.getElementById('plan-modal')!;
  const iframe = document.getElementById('plan-iframe') as HTMLIFrameElement;
  const modalTitle = document.getElementById('plan-modal-title')!;
  const openTabLink = document.getElementById('plan-open-tab') as HTMLAnchorElement;
  const downloadLink = document.getElementById('plan-download') as HTMLAnchorElement;
  const closeBtn = document.getElementById('plan-close')!;

  function handlePlanClick(e: Event) {
    const mouseEvt = e as MouseEvent;
    // Let ctrl/cmd/middle-click open in new tab natively
    if (mouseEvt.ctrlKey || mouseEvt.metaKey || mouseEvt.shiftKey || mouseEvt.button === 1) return;
    const btn = (e.target as HTMLElement).closest('.plan-view-btn') as HTMLElement | null;
    if (!btn) return;
    e.preventDefault();
    const pdf = btn.dataset.pdf!;
    const title = btn.dataset.title || 'Plano';
    modalTitle.textContent = title;
    iframe.src = pdf;
    openTabLink.href = pdf;
    downloadLink.href = pdf;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  tbody.addEventListener('click', handlePlanClick);
  cardsContainer.addEventListener('click', handlePlanClick);

  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
    iframe.src = '';
    document.body.style.overflow = '';
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (!modal.classList.contains('hidden')) closeModal();
      if (!tourModal.classList.contains('hidden')) closeTour();
    }
  });

