  <!-- ═══════════ SCRIPTS ═══════════ -->
  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import Swiper from 'swiper';
    import { Navigation, Thumbs, Autoplay } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/navigation';
    import 'swiper/css/thumbs';

    gsap.registerPlugin(ScrollTrigger);

    /* ── Gallery Swiper ── */
    const thumbsSwiper = new Swiper('.gallery-thumbs', {
      modules: [Autoplay],
      spaceBetween: 10,
      slidesPerView: 4,
      watchSlidesProgress: true,
      breakpoints: {
        640: { slidesPerView: 5 },
        1024: { slidesPerView: 7 },
      },
    });

    new Swiper('.gallery-main', {
      modules: [Navigation, Thumbs, Autoplay],
      spaceBetween: 0,
      loop: true,
      autoplay: { delay: 4000, disableOnInteraction: true },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      thumbs: { swiper: thumbsSwiper },
    });

    /* ── Hero animation ── */
    const heroContent = document.getElementById('hero-content');
    if (heroContent) {
      const tl = gsap.timeline({ delay: 0.3 });
      tl.from(heroContent.querySelector('.label-md')!, { opacity: 0, y: 30, duration: 0.6, ease: 'power3.out' })
        .from(heroContent.querySelector('h1')!, { opacity: 0, y: 50, duration: 0.8, ease: 'power3.out' }, '-=0.3')
        .from(heroContent.querySelector('p')!, { opacity: 0, y: 30, duration: 0.6, ease: 'power3.out' }, '-=0.4')
        .from(heroContent.querySelectorAll('a, button'), { opacity: 0, y: 20, duration: 0.5, stagger: 0.1, ease: 'power3.out' }, '-=0.3');
    }

    /* ── Hero parallax ── */
    const heroImg = document.getElementById('hero-img');
    if (heroImg) {
      gsap.to(heroImg, {
        y: 80, scale: 1.1, ease: 'none',
        scrollTrigger: { trigger: '#inicio', start: 'top top', end: 'bottom top', scrub: 1 },
      });
    }

    /* ── Nav shrink ── */
    const navInner = document.getElementById('nav-inner');
    const nav = document.getElementById('main-nav');
    ScrollTrigger.create({
      start: 'top -100',
      onUpdate: (self) => {
        if (self.direction === 1 && self.progress > 0) {
          nav?.classList.add('shadow-lg');
          navInner?.classList.remove('h-20');
          navInner?.classList.add('h-14');
        } else if (self.progress === 0) {
          nav?.classList.remove('shadow-lg');
          navInner?.classList.remove('h-14');
          navInner?.classList.add('h-20');
        }
      },
    });

    /* ── Scroll reveals ── */
    document.querySelectorAll('.anim-reveal').forEach((el) => {
      gsap.from(el, {
        opacity: 0, y: 50, duration: 0.9, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 88%', once: true },
      });
    });

    document.querySelectorAll('.anim-stagger').forEach((el) => {
      gsap.from(el.children, {
        opacity: 0, y: 35, duration: 0.7, ease: 'power3.out', stagger: 0.08,
        scrollTrigger: { trigger: el, start: 'top 88%', once: true },
      });
    });

    /* ── Counter animation ── */
    document.querySelectorAll('[data-count]').forEach((el) => {
      const target = parseInt(el.getAttribute('data-count') || '0');
      const obj = { val: 0 };
      gsap.to(obj, {
        val: target, duration: 2, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        onUpdate: () => { (el as HTMLElement).textContent = Math.round(obj.val).toString(); },
      });
    });

    /* ── Active nav link ── */
    const sections = ['inicio', 'calidades', 'viviendas', 'planos', 'contacto'];
    const navLinks = document.querySelectorAll('.nav-link');
    sections.forEach((id, i) => {
      ScrollTrigger.create({
        trigger: `#${id}`,
        start: 'top center',
        end: 'bottom center',
        onEnter: () => setActive(i),
        onEnterBack: () => setActive(i),
      });
    });
    function setActive(index: number) {
      navLinks.forEach((link, i) => {
        if (i === index) {
          link.classList.add('text-primary', 'font-semibold', 'border-primary');
          link.classList.remove('text-on-surface-variant', 'border-transparent');
        } else {
          link.classList.remove('text-primary', 'font-semibold', 'border-primary');
          link.classList.add('text-on-surface-variant', 'border-transparent');
        }
      });
    }

    /* ── Mobile menu ── */
    const mobileMenu = document.getElementById('mobile-menu');
    document.getElementById('menu-toggle')?.addEventListener('click', () => mobileMenu?.classList.add('open'));
    document.getElementById('menu-close')?.addEventListener('click', () => mobileMenu?.classList.remove('open'));
    document.querySelectorAll('.mobile-link').forEach((l) => l.addEventListener('click', () => mobileMenu?.classList.remove('open')));

    /* ── Form ── */
    document.getElementById('contact-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const btn = (e.target as HTMLFormElement).querySelector('button[type="submit"]') as HTMLButtonElement;
      if (btn) {
        btn.innerHTML = '<span class="flex items-center justify-center gap-2">Solicitud Enviada <span class="material-symbols-outlined">check_circle</span></span>';
        btn.classList.add('opacity-80', 'pointer-events-none');
        gsap.from(btn, { scale: 0.95, duration: 0.3, ease: 'back.out(1.7)' });
      }
    });
  </script>

