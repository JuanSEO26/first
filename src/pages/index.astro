---
import '../styles/global.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Molí Baix — Obra nueva en Massamagrell, Valencia. Viviendas de 1, 2 y 3 dormitorios. Desde 145.000€. Diseño, luz y eficiencia energética." />
  <title>Molí Baix — Tu hogar en Massamagrell</title>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
</head>

<body>

  <!-- ═══════════ NAVIGATION ═══════════ -->
  <nav id="main-nav" class="fixed top-0 w-full z-50 glass-nav transition-all duration-500">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 flex justify-between items-center h-20 transition-all duration-300" id="nav-inner">
      <a href="#" class="text-2xl font-extrabold tracking-tighter font-headline text-on-background">
        Molí Baix
      </a>
      <div class="hidden lg:flex items-center gap-10">
        <a href="#inicio" class="nav-link text-sm font-semibold text-primary border-b-2 border-primary pb-1 transition-all duration-300">Inicio</a>
        <a href="#calidades" class="nav-link text-sm font-medium text-on-surface-variant hover:text-primary pb-1 border-b-2 border-transparent hover:border-primary transition-all duration-300">Calidades</a>
        <a href="#viviendas" class="nav-link text-sm font-medium text-on-surface-variant hover:text-primary pb-1 border-b-2 border-transparent hover:border-primary transition-all duration-300">Viviendas</a>
        <a href="#planos" class="nav-link text-sm font-medium text-on-surface-variant hover:text-primary pb-1 border-b-2 border-transparent hover:border-primary transition-all duration-300">Planos</a>
        <a href="#contacto" class="nav-link text-sm font-medium text-on-surface-variant hover:text-primary pb-1 border-b-2 border-transparent hover:border-primary transition-all duration-300">Contacto</a>
      </div>
      <div class="flex items-center gap-4">
        <a href="#contacto" class="hidden sm:inline-flex btn-primary-gradient text-on-primary px-7 py-2.5 rounded-full font-semibold text-sm transition-all active:scale-95 hover:shadow-lg">
          Descargar Folleto
        </a>
        <button id="menu-toggle" class="lg:hidden flex flex-col gap-1.5 p-2" aria-label="Abrir menú">
          <span class="block w-6 h-0.5 bg-on-background transition-all duration-300"></span>
          <span class="block w-6 h-0.5 bg-on-background transition-all duration-300"></span>
          <span class="block w-4 h-0.5 bg-on-background transition-all duration-300"></span>
        </button>
      </div>
    </div>
    <!-- Mobile menu -->
    <div id="mobile-menu" class="mobile-menu fixed top-0 right-0 w-80 h-screen bg-surface-container-lowest shadow-2xl z-50 p-10 flex flex-col gap-8">
      <button id="menu-close" class="self-end p-2" aria-label="Cerrar menú">
        <span class="material-symbols-outlined text-3xl text-on-surface">close</span>
      </button>
      <a href="#inicio" class="text-xl font-headline font-bold text-on-background hover:text-primary transition-colors mobile-link">Inicio</a>
      <a href="#calidades" class="text-xl font-headline font-bold text-on-background hover:text-primary transition-colors mobile-link">Calidades</a>
      <a href="#viviendas" class="text-xl font-headline font-bold text-on-background hover:text-primary transition-colors mobile-link">Viviendas</a>
      <a href="#planos" class="text-xl font-headline font-bold text-on-background hover:text-primary transition-colors mobile-link">Planos y Disponibilidad</a>
      <a href="#contacto" class="text-xl font-headline font-bold text-on-background hover:text-primary transition-colors mobile-link">Contacto</a>
      <a href="#contacto" class="btn-primary-gradient text-on-primary px-7 py-3 rounded-full font-semibold text-center mt-auto">Solicitar Info</a>
    </div>
  </nav>


  <main>

    <!-- ═══════════ HERO ═══════════ -->
    <section id="inicio" class="relative min-h-screen flex items-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img id="hero-img" class="w-full h-full object-cover object-center scale-105"
          src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_13.webp"
          alt="Edificio residencial Molí Baix en Massamagrell con arquitectura moderna" />
        <div class="absolute inset-0 bg-gradient-to-r from-on-background/70 via-on-background/40 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-on-background/30 to-transparent"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full py-32 lg:py-40" id="hero-content">
        <div class="max-w-2xl">
          <span class="label-md tracking-[0.25em] text-primary-fixed-dim mb-6 block font-bold">Obra Nueva en Massamagrell</span>
          <h1 class="text-5xl sm:text-6xl lg:text-8xl font-extrabold font-headline leading-[0.9] text-white tracking-tighter mb-6">
            Tu hogar en<br/>Massamagrell
          </h1>
          <p class="text-xl lg:text-2xl text-white/70 max-w-lg mb-10 leading-relaxed font-light">
            Donde la luz y la calma se encuentran.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a href="#viviendas" class="btn-primary-gradient text-on-primary px-10 py-4 rounded-full font-semibold text-lg transition-all active:scale-95 hover:shadow-xl">
              Ver Viviendas
            </a>
            <a href="#contacto" class="border-2 border-white/30 text-white px-10 py-4 rounded-full font-semibold text-lg transition-all hover:bg-white/10 active:scale-95">
              Descargar Folleto
            </a>
          </div>
        </div>
      </div>
      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2">
        <span class="text-[0.6rem] text-white/50 uppercase tracking-[0.3em] font-semibold">Scroll</span>
        <div class="w-px h-10 bg-white/30 animate-pulse"></div>
      </div>
    </section>


    <!-- ═══════════ DISCOVER ═══════════ -->
    <section id="descubre" class="py-16 lg:py-24 bg-surface-container-lowest">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-10 anim-reveal">
          <span class="label-md tracking-[0.25em] text-primary mb-4 block font-bold">Descubre Molí Baix</span>
          <h2 class="text-3xl lg:text-5xl font-extrabold font-headline text-on-background tracking-tighter mb-6">
            Imagina despertar con la luz del sol, rodeado de campos de naranjos
          </h2>
          <p class="text-on-surface-variant text-lg leading-relaxed">
            A solo 15 minutos de Valencia. Viviendas modernas, funcionales y llenas de luz. Un proyecto de 78 viviendas diseñado para maximizar tu bienestar, combinando sostenibilidad con elegancia contemporánea.
          </p>
        </div>

        <!-- Feature cards -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-surface-container-high overflow-hidden rounded-2xl anim-reveal">
          <div class="bg-surface-container-lowest p-8 lg:p-12 text-center transition-all duration-300 hover:bg-primary-fixed group cursor-default">
            <span class="material-symbols-outlined text-4xl text-primary mb-4 block group-hover:scale-110 transition-transform duration-300">bedroom_parent</span>
            <h3 class="text-2xl lg:text-3xl font-extrabold font-headline mb-1 text-on-background">1, 2 y 3</h3>
            <p class="label-md text-secondary tracking-widest">Dormitorios</p>
          </div>
          <div class="bg-surface-container-lowest p-8 lg:p-12 text-center transition-all duration-300 hover:bg-primary-fixed group cursor-default">
            <span class="material-symbols-outlined text-4xl text-primary mb-4 block group-hover:scale-110 transition-transform duration-300">apartment</span>
            <h3 class="text-2xl lg:text-3xl font-extrabold font-headline mb-1 text-on-background" data-count="78">0</h3>
            <p class="label-md text-secondary tracking-widest">Viviendas</p>
          </div>
          <div class="bg-surface-container-lowest p-8 lg:p-12 text-center transition-all duration-300 hover:bg-primary-fixed group cursor-default">
            <span class="material-symbols-outlined text-4xl text-primary mb-4 block group-hover:scale-110 transition-transform duration-300">garage_home</span>
            <h3 class="text-2xl lg:text-3xl font-extrabold font-headline mb-1 text-on-background">Garaje</h3>
            <p class="label-md text-secondary tracking-widest">y Trastero</p>
          </div>
          <div class="bg-surface-container-lowest p-8 lg:p-12 text-center transition-all duration-300 hover:bg-primary-fixed group cursor-default">
            <span class="material-symbols-outlined text-4xl text-primary mb-4 block group-hover:scale-110 transition-transform duration-300">energy_savings_leaf</span>
            <h3 class="text-2xl lg:text-3xl font-extrabold font-headline mb-1 text-on-background">Alta</h3>
            <p class="label-md text-secondary tracking-widest">Eficiencia Energética</p>
          </div>
        </div>
        <p class="text-xs text-secondary text-center mt-4 italic">* Garaje y trastero aplicable únicamente a determinadas viviendas; consulte la descripción de cada unidad para confirmar su inclusión.</p>
      </div>
    </section>


    <!-- ═══════════ LOCATION ═══════════ -->
    <section id="ubicacion" class="py-16 lg:py-24 bg-surface-container overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="text-center mb-12 anim-reveal">
          <span class="label-md tracking-[0.25em] text-primary mb-4 font-bold block">Ubicación Privilegiada</span>
          <h2 class="text-3xl lg:text-5xl font-extrabold font-headline text-on-background tracking-tighter">Una ubicación que respira naturaleza y cercanía</h2>
          <p class="text-on-surface-variant text-lg mt-4 max-w-2xl mx-auto">
            Massamagrell ofrece el equilibrio perfecto entre la tranquilidad de una zona residencial y la comodidad de tener Valencia y todos los servicios a un paso.
          </p>
        </div>

        <!-- Distance items - horizontal row -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6 mb-12 anim-reveal">
          <div class="text-center">
            <div class="w-14 h-14 rounded-full bg-primary-fixed flex items-center justify-center mx-auto mb-3">
              <span class="material-symbols-outlined text-primary">directions_subway</span>
            </div>
            <h4 class="font-bold text-on-background text-sm">Metro</h4>
            <p class="text-secondary text-sm">5 min andando</p>
          </div>
          <div class="text-center">
            <div class="w-14 h-14 rounded-full bg-primary-fixed flex items-center justify-center mx-auto mb-3">
              <span class="material-symbols-outlined text-primary">flight</span>
            </div>
            <h4 class="font-bold text-on-background text-sm">Aeropuerto</h4>
            <p class="text-secondary text-sm">20 min en coche</p>
          </div>
          <div class="text-center">
            <div class="w-14 h-14 rounded-full bg-primary-fixed flex items-center justify-center mx-auto mb-3">
              <span class="material-symbols-outlined text-primary">beach_access</span>
            </div>
            <h4 class="font-bold text-on-background text-sm">Playa</h4>
            <p class="text-secondary text-sm">8–10 min en coche</p>
          </div>
          <div class="text-center">
            <div class="w-14 h-14 rounded-full bg-primary-fixed flex items-center justify-center mx-auto mb-3">
              <span class="material-symbols-outlined text-primary">location_city</span>
            </div>
            <h4 class="font-bold text-on-background text-sm">Valencia Centro</h4>
            <p class="text-secondary text-sm">20 min coche / 25 metro</p>
          </div>
          <div class="text-center col-span-2 sm:col-span-1">
            <div class="w-14 h-14 rounded-full bg-primary-fixed flex items-center justify-center mx-auto mb-3">
              <span class="material-symbols-outlined text-primary">storefront</span>
            </div>
            <h4 class="font-bold text-on-background text-sm">Servicios</h4>
            <p class="text-secondary text-sm">Colegios, comercios, salud</p>
          </div>
        </div>

        <!-- Real Google Maps embed -->
        <div class="rounded-2xl overflow-hidden editorial-shadow-lg anim-reveal">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12336.5!2d-0.3297!3d39.5671!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd604f4cf980f1e1%3A0x4068e29c34ef0d0!2sMassamagrell%2C%20Valencia!5e0!3m2!1ses!2ses!4v1700000000000!5m2!1ses!2ses"
            width="100%" height="450" style="border:0;" allowfullscreen loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-[350px] lg:h-[450px]"
            title="Ubicación de Molí Baix en Massamagrell, Valencia"
          ></iframe>
        </div>
      </div>
    </section>


    <!-- ═══════════ GALLERY ═══════════ -->
    <section id="galeria" class="py-16 lg:py-24 bg-surface-container-lowest overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 lg:px-8 mb-10 anim-reveal">
        <span class="label-md tracking-[0.25em] text-primary mb-4 font-bold block">Galería</span>
        <h2 class="text-3xl lg:text-5xl font-extrabold font-headline text-on-background tracking-tighter">Conoce cada rincón</h2>
      </div>

      <!-- Main Swiper -->
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="swiper gallery-main rounded-2xl overflow-hidden editorial-shadow-lg mb-6">
          <div class="swiper-wrapper">
            <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_1.webp" alt="Fachada principal Molí Baix" /></div>
            <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_2.webp" alt="Salón luminoso con grandes ventanales" /></div>
            <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_3.webp" alt="Cocina moderna equipada" /></div>
            <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_4.webp" alt="Dormitorio principal con luz natural" /></div>
            <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_5.webp" alt="Baño con acabados premium" /></div>
            <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_6.webp" alt="Terraza con vistas" /></div>
            <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_8-1.webp" alt="Zona comunitaria" /></div>
            <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_9.webp" alt="Detalle de acabados interiores" /></div>
            <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_10.webp" alt="Vista exterior del edificio" /></div>
            <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_11.webp" alt="Espacio de convivencia" /></div>
            <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_13.webp" alt="Perspectiva nocturna" /></div>
            <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_14.webp" alt="Jardín comunitario" /></div>
            <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_15.webp" alt="Piscina comunitaria" /></div>
            <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_16.webp" alt="Zona ajardinada" /></div>
            <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_17.webp" alt="Detalle arquitectónico" /></div>
            <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_18.webp" alt="Vista panorámica" /></div>
          </div>
          <div class="swiper-button-next"></div>
          <div class="swiper-button-prev"></div>
        </div>

        <!-- Thumbs -->
        <div class="swiper gallery-thumbs">
          <div class="swiper-wrapper">
            <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_1.webp" alt="" /></div>
            <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_2.webp" alt="" /></div>
            <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_3.webp" alt="" /></div>
            <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_4.webp" alt="" /></div>
            <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_5.webp" alt="" /></div>
            <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_6.webp" alt="" /></div>
            <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_8-1.webp" alt="" /></div>
            <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_9.webp" alt="" /></div>
            <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_10.webp" alt="" /></div>
            <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_11.webp" alt="" /></div>
            <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_13.webp" alt="" /></div>
            <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_14.webp" alt="" /></div>
            <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_15.webp" alt="" /></div>
            <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_16.webp" alt="" /></div>
            <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_17.webp" alt="" /></div>
            <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_18.webp" alt="" /></div>
          </div>
        </div>
      </div>
    </section>


    <!-- ═══════════ CALIDADES (Qualities) ═══════════ -->
    <section id="calidades" class="py-16 lg:py-24 bg-surface-container">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <!-- Images -->
          <div class="relative anim-reveal">
            <div class="rounded-2xl overflow-hidden editorial-shadow-lg">
              <img class="w-full aspect-[4/3] object-cover"
                src="https://molibaix.com/wp-content/uploads/2026/02/VIBO_massamagrell_gallery_3.webp"
                alt="Interior de alta calidad con materiales premium" />
            </div>
            <div class="absolute -bottom-8 -right-4 lg:-bottom-12 lg:-right-10 w-2/5 rounded-xl overflow-hidden border-8 border-surface-container shadow-2xl hidden sm:block">
              <img class="w-full aspect-square object-cover"
