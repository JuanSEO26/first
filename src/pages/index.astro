---
import Layout from '../layouts/Layout.astro';
---

<Layout currentPage="inicio">

  <!-- ═══════════ HERO ═══════════ -->
  <section id="inicio" class="relative min-h-screen flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img id="hero-img" width="1920" height="1080" fetchpriority="high" decoding="async" class="w-full h-full object-cover object-center scale-105"
        src="/images/plano-exteriror-pajaro2.webp"
        alt="Edificio residencial Molí Baix en Massamagrell con arquitectura moderna" />
      <div class="absolute inset-0 bg-gradient-to-r from-on-background/70 via-on-background/40 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-on-background/30 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full py-32 lg:py-40" id="hero-content">
      <div class="max-w-2xl">
        <span class="hero-anim-init label-md tracking-[0.25em] text-primary-fixed-dim mb-4 block font-bold">Obra Nueva en Massamagrell</span>
        <h1 class="hero-anim-init text-4xl sm:text-5xl lg:text-7xl font-extrabold font-headline text-white mb-5">
          Tu hogar en<br/>Massamagrell
        </h1>
        <p class="hero-anim-init text-xl lg:text-2xl text-white/70 max-w-xl font-light mb-10">
          Donde la luz y la calma se encuentran.
        </p>
        <div class="flex flex-wrap items-center gap-4" data-hero-ctas>
          <a href="/viviendas" class="hero-anim-init btn-primary-gradient text-on-primary px-10 py-4 rounded-full font-semibold text-lg transition-all active:scale-95 hover:shadow-xl">
            Ver Viviendas
          </a>
          <a href="/#contacto" class="hero-anim-init border-2 border-white/30 text-white px-10 py-4 rounded-full font-semibold text-lg transition-all hover:bg-white/10 active:scale-95">
            Hablemos
          </a>
        </div>
      </div>
    </div>
    <!-- Scroll indicator (desktop only) -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 hidden lg:flex flex-col items-center" aria-hidden="true">
      <span class="material-symbols-outlined text-white/40 text-2xl motion-safe:animate-bounce">expand_more</span>
    </div>
  </section>


  <!-- ═══════════ DISCOVER ═══════════ -->
  <section id="descubre" class="py-16 lg:py-24 bg-surface-container-lowest">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-12 lg:mb-14 anim-reveal">
        <span class="label-md tracking-[0.25em] text-primary mb-4 block font-bold">Descubre Molí Baix</span>
        <h2 class="text-3xl lg:text-5xl font-extrabold font-headline text-on-background mb-4">
          Imagina despertar con la luz del sol, rodeado de campos de naranjos
        </h2>
        <div class="divider-accent mx-auto mb-6"></div>
        <p class="text-on-surface-variant text-lg">
          A solo 15 minutos de Valencia. Viviendas modernas, funcionales y llenas de luz. Un proyecto de 78 viviendas diseñado para maximizar tu bienestar, combinando sostenibilidad con elegancia contemporánea.
        </p>
      </div>

      <!-- Feature cards -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-surface-container-high overflow-hidden rounded-2xl anim-reveal">
        <div class="bg-surface-container-lowest p-8 lg:p-12 text-center transition-all duration-300 group">
          <span class="material-symbols-outlined text-4xl text-primary mb-4 block group-hover:scale-110 transition-transform duration-300">bedroom_parent</span>
          <h3 class="text-2xl lg:text-3xl font-extrabold font-headline mb-1 text-on-background">1, 2 y 3</h3>
          <p class="label-md text-secondary tracking-widest">Dormitorios</p>
        </div>
        <div class="bg-surface-container-lowest p-8 lg:p-12 text-center transition-all duration-300 group">
          <span class="material-symbols-outlined text-4xl text-primary mb-4 block group-hover:scale-110 transition-transform duration-300">apartment</span>
          <h3 class="text-2xl lg:text-3xl font-extrabold font-headline mb-1 text-on-background tabular-nums" data-count="78" aria-label="78 viviendas">0</h3>
          <p class="label-md text-secondary tracking-widest">Viviendas</p>
        </div>
        <div class="bg-surface-container-lowest p-8 lg:p-12 text-center transition-all duration-300 group">
          <span class="material-symbols-outlined text-4xl text-primary mb-4 block group-hover:scale-110 transition-transform duration-300">garage_home</span>
          <h3 class="text-2xl lg:text-3xl font-extrabold font-headline mb-1 text-on-background">Garaje</h3>
          <p class="label-md text-secondary tracking-widest">y Trastero</p>
        </div>
        <div class="bg-surface-container-lowest p-8 lg:p-12 text-center transition-all duration-300 group">
          <span class="material-symbols-outlined text-4xl text-primary mb-4 block group-hover:scale-110 transition-transform duration-300">energy_savings_leaf</span>
          <h3 class="text-2xl lg:text-3xl font-extrabold font-headline mb-1 text-on-background">Alta</h3>
          <p class="label-md text-secondary tracking-widest">Eficiencia Energética</p>
        </div>
      </div>
      <p class="text-xs text-secondary text-center mt-4 italic">* Garaje y trastero aplicable únicamente a determinadas viviendas; consulte la descripción de cada unidad para confirmar su inclusión.</p>
    </div>
  </section>


  <!-- ═══════════ LOCATION ═══════════ -->
  <section id="ubicacion" class="py-16 lg:py-24 bg-surface-container overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-12 lg:mb-14 anim-reveal">
        <span class="label-md tracking-[0.25em] text-primary mb-4 font-bold block">Ubicación Privilegiada</span>
        <h2 class="text-3xl lg:text-5xl font-extrabold font-headline text-on-background mb-4">Una ubicación que respira naturaleza y cercanía</h2>
        <div class="divider-accent mx-auto mb-6"></div>
        <p class="text-on-surface-variant text-lg max-w-2xl mx-auto">
          Massamagrell ofrece el equilibrio perfecto entre la tranquilidad de una zona residencial y la comodidad de tener Valencia y todos los servicios a un paso.
        </p>
      </div>

      <!-- Distance items - horizontal row -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6 mb-12 anim-reveal">
        <div class="text-center group">
          <div class="w-14 h-14 rounded-2xl bg-primary-fixed flex items-center justify-center mx-auto mb-3 transition-transform duration-300">
            <span class="material-symbols-outlined text-primary">directions_subway</span>
          </div>
          <h4 class="font-bold text-on-background text-sm">Metro</h4>
          <p class="text-secondary text-sm">5 min andando</p>
        </div>
        <div class="text-center group">
          <div class="w-14 h-14 rounded-2xl bg-primary-fixed flex items-center justify-center mx-auto mb-3 transition-transform duration-300">
            <span class="material-symbols-outlined text-primary">flight</span>
          </div>
          <h4 class="font-bold text-on-background text-sm">Aeropuerto</h4>
          <p class="text-secondary text-sm">20 min en coche</p>
        </div>
        <div class="text-center group">
          <div class="w-14 h-14 rounded-2xl bg-primary-fixed flex items-center justify-center mx-auto mb-3 transition-transform duration-300">
            <span class="material-symbols-outlined text-primary">beach_access</span>
          </div>
          <h4 class="font-bold text-on-background text-sm">Playa</h4>
          <p class="text-secondary text-sm">8–10 min en coche</p>
        </div>
        <div class="text-center group">
          <div class="w-14 h-14 rounded-2xl bg-primary-fixed flex items-center justify-center mx-auto mb-3 transition-transform duration-300">
            <span class="material-symbols-outlined text-primary">location_city</span>
          </div>
          <h4 class="font-bold text-on-background text-sm">Valencia Centro</h4>
          <p class="text-secondary text-sm">20 min coche / 25 metro</p>
        </div>
        <div class="text-center col-span-2 sm:col-span-1 group">
          <div class="w-14 h-14 rounded-2xl bg-primary-fixed flex items-center justify-center mx-auto mb-3 transition-transform duration-300">
            <span class="material-symbols-outlined text-primary">storefront</span>
          </div>
          <h4 class="font-bold text-on-background text-sm">Servicios</h4>
          <p class="text-secondary text-sm">Colegios, comercios, salud</p>
        </div>
      </div>

      <!-- Real Google Maps embed -->
      <div class="rounded-2xl overflow-hidden editorial-shadow-lg anim-reveal">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12336.5!2d-0.3297!3d39.5671!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd604f4cf980f1e1%3A0x4068e29c34ef0d0!2sMassamagrell%2C%20Valencia!5e0!3m2!1ses!2ses!4v1700000000000!5m2!1ses!2ses"
          width="1200" height="450" style="border:0;" allowfullscreen loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-[350px] lg:h-[450px]"
          title="Ubicación de Molí Baix en Massamagrell, Valencia"
        ></iframe>
      </div>
    </div>
  </section>


  <!-- ═══════════ GALLERY ═══════════ -->
  <section id="galeria" class="py-16 lg:py-24 bg-surface-container-lowest overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 mb-10 anim-reveal">
      <span class="label-md tracking-[0.25em] text-primary mb-4 font-bold block">Galería</span>
      <h2 class="text-3xl lg:text-5xl font-extrabold font-headline text-on-background mb-4">Conoce cada rincón</h2>
      <div class="divider-accent mb-0"></div>
    </div>

    <!-- Main Swiper -->
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="swiper gallery-main rounded-2xl overflow-hidden editorial-shadow-lg mb-6">
        <div class="swiper-wrapper">
          <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="/images/plano-exterior-frontal.webp" alt="Fachada principal Molí Baix" /></div>
          <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="/images/salon-ventanal.webp" alt="Salón luminoso con grandes ventanales" /></div>
          <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="/images/cocina.webp" alt="Cocina moderna equipada" /></div>
          <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="/images/dormitorio-matrimonio.webp" alt="Dormitorio principal con luz natural" /></div>
          <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="/images/bano.webp" alt="Baño con acabados premium" /></div>
          <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="/images/jardines.webp" alt="Zonas comunes exteriores" /></div>
          <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="/images/gimnasio.webp" alt="Gimnasio comunitario" /></div>
          <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="/images/cocina-recibidor.webp" alt="Cocina abierta con comedor" /></div>
          <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="/images/exterior-esquina.webp" alt="Vista exterior del edificio" /></div>
          <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="/images/salon.webp" alt="Salón comedor" /></div>
          <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="/images/plano-exteriror-pajaro2.webp" alt="Vista aérea al atardecer" /></div>
          <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="/images/cocina-salon.webp" alt="Cocina con isla y salón" /></div>
          <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="/images/dormitorio-doble.webp" alt="Dormitorio doble" /></div>
          <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="/images/dormitorio-individual.webp" alt="Dormitorio individual" /></div>
          <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="/images/ducha-bano.webp" alt="Ducha con acabados premium" /></div>
          <div class="swiper-slide"><img class="w-full h-[300px] sm:h-[400px] lg:h-[540px] object-cover" src="/images/plano-exteriror-pajaro.webp" alt="Vista aérea panorámica" /></div>
        </div>
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
      </div>

      <!-- Thumbs -->
      <div class="swiper gallery-thumbs">
        <div class="swiper-wrapper">
          <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="/images/plano-exterior-frontal.webp" alt="" /></div>
          <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="/images/salon-ventanal.webp" alt="" /></div>
          <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="/images/cocina.webp" alt="" /></div>
          <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="/images/dormitorio-matrimonio.webp" alt="" /></div>
          <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="/images/bano.webp" alt="" /></div>
          <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="/images/jardines.webp" alt="" /></div>
          <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="/images/gimnasio.webp" alt="" /></div>
          <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="/images/cocina-recibidor.webp" alt="" /></div>
          <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="/images/exterior-esquina.webp" alt="" /></div>
          <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="/images/salon.webp" alt="" /></div>
          <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="/images/plano-exteriror-pajaro2.webp" alt="" /></div>
          <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="/images/cocina-salon.webp" alt="" /></div>
          <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="/images/dormitorio-doble.webp" alt="" /></div>
          <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="/images/dormitorio-individual.webp" alt="" /></div>
          <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="/images/ducha-bano.webp" alt="" /></div>
          <div class="swiper-slide cursor-pointer"><img class="w-full h-16 lg:h-20 object-cover rounded-lg gallery-thumb" src="/images/plano-exteriror-pajaro.webp" alt="" /></div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════ CALIDADES TEASER ═══════════ -->
  <section id="calidades" class="py-16 lg:py-24 bg-surface-container">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <!-- Images -->
        <div class="relative anim-reveal">
          <div class="rounded-2xl overflow-hidden editorial-shadow-lg">
            <img class="w-full aspect-[4/3] object-cover" loading="lazy"
              src="/images/cocina.webp"
              alt="Interior de alta calidad con materiales premium" />
          </div>
          <div class="absolute -bottom-6 -right-4 lg:-bottom-10 lg:-right-8 w-2/5 rounded-xl overflow-hidden border-8 border-surface-container shadow-2xl hidden sm:block">
            <img class="w-full aspect-square object-cover" loading="lazy"
              src="/images/ducha-bano.webp"
              alt="Detalle de acabados de baño con Porcelanosa" />
          </div>
        </div>

        <!-- Content -->
        <div class="anim-reveal flex flex-col justify-center">
          <span class="label-md tracking-[0.25em] text-primary mb-4 font-bold block">Calidades y Acabados</span>
          <h2 class="text-3xl lg:text-5xl font-extrabold font-headline text-on-background mb-4">Mucho más que una vivienda</h2>
          <div class="divider-accent mb-6"></div>
          <p class="text-on-surface-variant mb-10 text-lg">
            Vivienda práctica con distribuciones inteligentes, materiales de alta calidad y eficiencia energética superior. Equipamiento y materiales de marcas líderes: Porcelanosa, Pamesa y Balay.
          </p>

          <!-- Features grid -->
          <div class="grid grid-cols-2 gap-6 mb-10 anim-reveal">
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary text-xl mt-0.5">fitness_center</span>
              <div>
                <h4 class="font-bold text-sm text-on-background">Gimnasio Equipado</h4>
                <p class="text-secondary text-xs">Espacio exclusivo de salud y bienestar</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary text-xl mt-0.5">heat_pump</span>
              <div>
                <h4 class="font-bold text-sm text-on-background">Aerotermia</h4>
                <p class="text-secondary text-xs">ACS comunitaria de alta eficiencia</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary text-xl mt-0.5">ac_unit</span>
              <div>
                <h4 class="font-bold text-sm text-on-background">Climatización</h4>
                <p class="text-secondary text-xs">Control térmico óptimo en toda la vivienda</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary text-xl mt-0.5">balcony</span>
              <div>
                <h4 class="font-bold text-sm text-on-background">Terrazas</h4>
                <p class="text-secondary text-xs">Espacios exteriores para disfrutar</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary text-xl mt-0.5">electric_car</span>
              <div>
                <h4 class="font-bold text-sm text-on-background">Movilidad Sostenible</h4>
                <p class="text-secondary text-xs">Parking bici y preinstalación coche eléctrico</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary text-xl mt-0.5">lightbulb</span>
              <div>
                <h4 class="font-bold text-sm text-on-background">Iluminación LED</h4>
                <p class="text-secondary text-xs">Iluminación sostenible y eficiente</p>
              </div>
            </div>
          </div>

          <a href="/calidades" class="self-start inline-flex btn-primary-gradient text-on-primary px-8 py-3.5 rounded-full font-semibold text-sm mt-2 transition-all active:scale-95 hover:shadow-xl">
            Ver Calidades y Acabados
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════ VIVIENDAS (Housing Types) ═══════════ -->
  <section id="viviendas" class="py-16 lg:py-24 bg-surface-container-lowest">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-12 lg:mb-14 anim-reveal">
        <span class="label-md tracking-[0.25em] text-primary mb-4 block font-bold">Viviendas</span>
        <h2 class="text-3xl lg:text-5xl font-extrabold font-headline text-on-background mb-4">Encuentra tu hogar ideal</h2>
        <div class="divider-accent mx-auto mb-6"></div>
        <p class="text-on-surface-variant text-lg max-w-2xl mx-auto">Desde lofts en planta baja hasta áticos con solárium privado. Múltiples configuraciones para adaptarse a tu estilo de vida.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 anim-reveal">

        <!-- Loft -->
        <a href="/planos?dorm=1&planta=0" class="block bg-white rounded-2xl overflow-hidden editorial-shadow border border-surface-container-high/40 group hover:shadow-xl card-lift">
          <div class="overflow-hidden">
            <img class="w-full h-52 object-cover img-zoom" loading="lazy" src="/images/salon-ventanal.webp" alt="Loft en planta baja" />
          </div>
          <div class="p-6">
            <div class="flex justify-between items-start mb-3">
              <h3 class="text-lg font-extrabold font-headline text-on-background">Loft</h3>
              <span class="label-md bg-primary-fixed text-on-primary-fixed-variant px-3 py-1 rounded-full">Desde 145.000€</span>
            </div>
            <div class="space-y-2 mb-4">
              <div class="flex items-center gap-2 text-sm text-secondary">
                <span class="material-symbols-outlined text-primary text-base">bed</span> 1 dormitorio + 1 baño
              </div>
              <div class="flex items-center gap-2 text-sm text-secondary">
                <span class="material-symbols-outlined text-primary text-base">straighten</span> 75 m² – 134 m²
              </div>
              <div class="flex items-center gap-2 text-sm text-secondary">
                <span class="material-symbols-outlined text-primary text-base">balcony</span> Terraza: 10,75 – 23,41 m²
              </div>
              <div class="flex items-center gap-2 text-sm text-secondary">
                <span class="material-symbols-outlined text-primary text-base">layers</span> Planta baja
              </div>
            </div>
            <p class="text-[0.65rem] text-secondary italic">10% de IVA no incluido</p>
          </div>
        </a>

        <!-- Ático -->
        <a href="/planos?planta=4" class="block bg-white rounded-2xl overflow-hidden editorial-shadow border border-surface-container-high/40 group hover:shadow-xl card-lift">
          <div class="overflow-hidden relative">
            <img class="w-full h-52 object-cover img-zoom" loading="lazy" src="/images/plano-exteriror-pajaro.webp" alt="Vista aérea del complejo con terrazas y solárium" />
