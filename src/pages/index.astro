<!-- ═══════════ PAGE-SPECIFIC SCRIPTS ═══════════ -->
<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Swiper from 'swiper';
  import { Navigation, Thumbs, Autoplay } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/thumbs';

  gsap.registerPlugin(ScrollTrigger);
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Gallery Swiper ── */
  const thumbsSwiper = new Swiper('.gallery-thumbs', {
    modules: [Autoplay],
    spaceBetween: 10,
    slidesPerView: 4,
    watchSlidesProgress: true,
    breakpoints: {
      640: { slidesPerView: 5 },
      1024: { slidesPerView: 7 },
    },
  });

  new Swiper('.gallery-main', {
    modules: [Navigation, Thumbs, Autoplay],
    spaceBetween: 0,
    loop: true,
    autoplay: { delay: 4000, disableOnInteraction: true },
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
    thumbs: { swiper: thumbsSwiper },
  });

  /* ── Hero entrance animation ── */
  const heroContent = document.getElementById('hero-content');
  if (heroContent && !prefersReducedMotion) {
    const label = heroContent.querySelector('.label-md');
    const heading = heroContent.querySelector('h1');
    const desc = heroContent.querySelector('p');
    const ctas = heroContent.querySelectorAll('[data-hero-ctas] > a');
    const tl = gsap.timeline({ delay: 0.2 });
    if (label) tl.fromTo(label, { opacity: 0, y: 25 }, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' });
    if (heading) tl.fromTo(heading, { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' }, '-=0.35');
    if (desc) tl.fromTo(desc, { opacity: 0, y: 25 }, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, '-=0.45');
    if (ctas.length) tl.fromTo(ctas, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.55, stagger: 0.12, ease: 'power3.out' }, '-=0.35');
  } else if (heroContent) {
    heroContent.querySelectorAll('.hero-anim-init').forEach((el) => (el as HTMLElement).style.opacity = '1');
  }

  /* ── Hero parallax (image only) ── */
  const heroImg = document.getElementById('hero-img');
  if (heroImg && !prefersReducedMotion) {
    gsap.to(heroImg, {
      y: 80, scale: 1.1, ease: 'none',
      scrollTrigger: { trigger: '#inicio', start: 'top top', end: 'bottom top', scrub: 1 },
    });
  }

  /* ── Active nav link (scroll-based for homepage) ── */
  const sectionToNav: [string, number][] = [
    ['inicio', 0],
    ['descubre', 0],
    ['ubicacion', 0],
    ['galeria', 0],
    ['calidades', 1],
    ['viviendas', 2],
    ['planos', 3],
    ['contacto', 3],
  ];
  const navLinks = document.querySelectorAll('.nav-link');
  sectionToNav.forEach(([id, navIndex]) => {
    const trigger = document.getElementById(id);
    if (!trigger) return;
    ScrollTrigger.create({
      trigger: `#${id}`,
      start: 'top center',
      end: 'bottom center',
      onEnter: () => setActive(navIndex),
      onEnterBack: () => setActive(navIndex),
    });
  });
  function setActive(index: number) {
    navLinks.forEach((link, i) => {
      if (i === index) {
        link.classList.add('text-primary', 'font-semibold', 'border-primary');
        link.classList.remove('text-on-surface-variant', 'border-transparent');
      } else {
        link.classList.remove('text-primary', 'font-semibold', 'border-primary');
        link.classList.add('text-on-surface-variant', 'border-transparent');
      }
    });
  }

  /* ── Form ── */
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const status = document.getElementById('contact-form-status');
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Enviando…';
    }
    setTimeout(() => {
      if (btn) btn.textContent = 'Solicitud enviada';
      if (status) status.textContent = '✓ Te contactaremos en menos de 24h.';
    }, 400);
  });
</script>
